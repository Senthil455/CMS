# --- Stage 1: Build Frontend & Backend ---
FROM node:24-slim AS builder
WORKDIR /app

# Install dependencies (utilizing workspace support)
COPY CMS/package.json cms/package-lock.json ./
COPY CMS/packages/shared/package.json ./packages/shared/
COPY CMS/packages/service/package.json ./packages/service/
COPY CMS/packages/app/package.json ./packages/app/
COPY CMS/packages/app/tsconfig.json ./packages/app/tsconfig.json
RUN npm install

# Copy Cms source code
COPY CMS/ .

# Build Shared Package
RUN npm run build:shared

# Build Frontend (outputs to packages/app/dist)
RUN cd packages/app && npm run build

# Build Backend
RUN cd packages/service && cp .env.production .env && npx prisma generate && npm run build

# --- Stage 2: Build CMS (.NET 10) ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS dotnet-builder
WORKDIR /src

# Expose target architecture for .NET RID mapping
ARG TARGETARCH

# Copy CMS source
COPY CMS/ ./

# Publish with the correct RID based on target platform
RUN if [ "$TARGETARCH" = "arm64" ]; then RID=linux-arm64; else RID=linux-x64; fi && \
    dotnet publish server/CMS.MonoApp/CMS.MonoApp.csproj -c Release -r $RID --self-contained false -o /app/publish

# --- Stage 3: Final Runtime ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# Install Node.js & Nginx
RUN apt-get update && apt-get install -y curl nginx procps && \
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Configure Nginx
COPY CMS/mono-deploy/nginx.conf /etc/nginx/nginx.conf
COPY CMS/mono-deploy/404.html /usr/share/nginx/html/404.html

# Copy Built Node.js App
COPY --from=builder /app /app

# Copy Built CMS App
COPY --from=dotnet-builder /app/publish ./cms
# Ensure appsettings is writable
RUN touch ./cms/appsettings.json && chmod 666 ./cms/appsettings.json

# Copy Entrypoint
COPY CMS/mono-deploy/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Expose Nginx Port
EXPOSE 5000

# Entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]
