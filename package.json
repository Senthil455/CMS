{
    "name": "cms",
    "private": true,
    "workspaces": [
        "packages/*",
        "packages/sdk",
        "packages/admin",
        "packages/portal",
        "packages/app"
    ],
    "scripts": {
        "debug": "concurrently \"npm run debug:service\" \"npm run dev:app\"",
        "dev": "concurrently \"npm run dev:service\" \"npm run dev:app\"",
        "dev:service": "npm run dev --workspace=@cms/service",
        "debug:service": "npm run debug --workspace=@cms/service",
        "dev:app": "npm run dev --workspace=@cms/app",
        "dev:admin": "npm run dev --workspace=@cms/admin",
        "dev:portal": "npm run dev --workspace=@cms/portal",
        "build:sdk": "npm run build --workspace=@cms/sdk",
        "build:shared": "npm run build --workspace=@cms/shared",
        "build:app": "npm run build --workspace=@cms/app",
        "build:all": "npm run build --workspaces --if-present",
        "install:all": "npm install",
        "setup": "npm run build:shared && npm run db:init --workspace=@cms/service"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0"
    },
    "dependencies": {
        "@fastify/static": "^9.0.0"
    }
}