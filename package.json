{
    "name": "cms",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm run debug:backend\" \"npm run dev:frontend\"",
        "dev:backend": "npm run dev --workspace=@cms/backend",
        "debug:backend": "npm run debug --workspace=@cms/backend",
        "dev:frontend": "npm run dev --workspace=@cms/frontend",
        "build:shared": "npm run build --workspace=@cms/shared",
        "install:all": "npm install"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "dependencies": {
        "@fastify/static": "^9.0.0"
    }
}
