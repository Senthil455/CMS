{
    "name": "cms",
    "private": true,
    "workspaces": [
        "packages/*",
        "packages/sdk",
        "packages/admin",
        "packages/portal",
        "packages/app"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:service\" \"npm run dev:app\"",
        "dev:service": "npm run dev --workspace=@cms/service",
        "debug:service": "npm run debug --workspace=@cms/service",
        "dev:app": "npm run dev --workspace=@cms/app",
        "dev:admin": "npm run dev --workspace=@cms/admin",
        "dev:portal": "npm run dev --workspace=@cms/portal",
        "build:shared": "npm run build --workspace=@cms/shared",
        "install:all": "npm install"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    },
    "dependencies": {
        "@fastify/static": "^9.0.0"
    }
}